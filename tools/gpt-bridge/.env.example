# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENAI_API_KEY=sk-...
# Any chat-completions model your key can reach.
OPENAI_MODEL=gpt-4o
# PORT=8787
# HOST=127.0.0.1
# Point at a compatible endpoint (Azure, OpenRouter, a local llama.cpp server, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
